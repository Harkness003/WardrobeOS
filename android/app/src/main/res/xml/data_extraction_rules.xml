<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Avoid a silent partial wardrobe restore on a nominally fresh install. -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="garment_images/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="garment_images/" />
    </device-transfer>
</data-extraction-rules>
